@model MultiTenantCSharpVargas.Models.Empresa?
@using MultiTenantCSharpVargas.Models

@{
    ViewData["Title"] = "Panel Comerciante";
}

@section Estilos {
    <link rel="stylesheet" href="~/css/componentes/panel-comerciante.css" asp-append-version="true" />
}

<div class="panel-comerciante">
    <div class="panel-cabecera">
        <div>
            <span class="etiqueta-seccion">Panel comerciante</span>
            <h1>Mi comercio</h1>
        </div>
    </div>

    @if (Model == null)
    {
        <div class="tarjeta-vacia">
            <p>Todavía no tenés una empresa registrada.</p>
            <a class="boton-principal" asp-action="CrearEmpresa">Crear mi empresa</a>
        </div>
    }
    else
    {
        <div class="tarjetas-resumen">
            <div class="tarjeta-resumen">
                <span class="numero">@Model.Productos.Count(p => p.Activo)</span>
                <span class="etiqueta">Productos activos</span>
            </div>
            <div class="tarjeta-resumen">
                <span class="numero">@Model.Productos.Count</span>
                <span class="etiqueta">Productos totales</span>
            </div>
            <div class="tarjeta-resumen">
                <span class="numero">@Model.Estado</span>
                <span class="etiqueta">Estado de la empresa</span>
            </div>
        </div>

        <div class="tarjeta-empresa">
            <h3>@Model.Nombre</h3>

            @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
            {
                <p>@Model.Descripcion</p>
            }

            <p><strong>Dirección:</strong> @Model.Direccion</p>
            <p><strong>Localidad:</strong> @Model.Localidad</p>
            <p><strong>Estado:</strong> <span class="etiqueta-estado">@Model.Estado</span></p>

            @if (Model.Estado == EstadoEmpresa.Pendiente)
            {
                <p class="aviso">Tu empresa está pendiente de aprobación por el Super Administrador. Podés cargar productos mientras esperás.</p>
            }
            else if (Model.Estado == EstadoEmpresa.Suspendida)
            {
                <p class="aviso">Tu empresa está suspendida: sus productos no aparecen en el catálogo público.</p>
            }

            <div class="acciones-panel">
                <a class="boton-principal" asp-action="Productos">Gestionar productos</a>
                <a asp-action="CrearProducto">Agregar producto</a>
                @if (Model.Estado == EstadoEmpresa.Activa)
                {
                    <a asp-controller="Inicio" asp-action="Empresa" asp-route-id="@Model.Id" target="_blank" rel="noopener">Ver en el catálogo</a>
                }
            </div>
        </div>
    }
</div>
