@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Roles (Vue/AJAX)";
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}

@section Estilos {
    <link rel="stylesheet" href="~/css/componentes/panel-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/componentes/roles-vue.css" asp-append-version="true" />
}

<div class="panel-admin">
    <h2>Roles del sistema</h2>

    <div class="acciones-panel">
        <button class="boton-principal" @click="abrirCrear()">+ Crear rol</button>
        <a asp-action="Roles">Vista MVC (respaldo)</a>
        <a asp-action="Index">Volver al panel</a>
    </div>

    <div class="buscador-roles">
        <input type="search" v-model="filtro" placeholder="Buscar rol por nombre o código..." @input="buscar" />
    </div>

    <p class="texto-tenue">
        Página {{ pagina }} de {{ totalPaginas }} · {{ total }} registro{{ total !== 1 ? 's' : '' }}
    </p>

    <div v-if="error" class="alerta-error">{{ error }}</div>
    <div v-if="mensaje" class="alerta-global alerta-global-exito">{{ mensaje }}</div>

    <table class="tabla-admin" v-if="roles.length">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Código</th>
                <th>Usuarios</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <tr v-for="rol in roles" :key="rol.id">
                <td>
                    <input v-if="editando === rol.id" v-model="rol.nombre" class="input-edicion" />
                    <span v-else>{{ rol.nombre }}</span>
                </td>
                <td>
                    <input v-if="editando === rol.id" v-model="rol.codigo" class="input-edicion" />
                    <code v-else>{{ rol.codigo }}</code>
                </td>
                <td>{{ rol.usuarios }}</td>
                <td>
                    <span class="estado-empresa" :class="rol.activo ? 'estado-activa' : 'estado-suspendida'">
                        {{ rol.activo ? 'Activo' : 'Inactivo' }}
                    </span>
                </td>
                <td>
                    <div class="acciones-fila">
                        <button v-if="editando === rol.id" class="boton-tabla boton-exito" @click="guardar(rol)">Guardar</button>
                        <button v-if="editando === rol.id" class="boton-tabla boton-peligro" @click="cancelarEdicion(rol)">Cancelar</button>
                        <button v-else @click="editar(rol)" class="boton-tabla">Editar</button>

                        <template v-if="rol.protegido">
                            <span class="texto-tenue boton-tabla" title="Protegido">—</span>
                        </template>
                        <template v-else>
                            <button v-if="!editando === rol.id" :disabled="cargando" class="boton-tabla"
                                    @click="cambiarEstado(rol)"
                                    title="{{ rol.activo ? 'Desactivar' : 'Activar' }}">
                                {{ rol.activo ? 'Desactivar' : 'Activar' }}
                            </button>
                            <button v-if="!editando === rol.id && rol.usuarios === 0" :disabled="cargando"
                                    class="boton-tabla boton-peligro" @click="eliminar(rol)">Eliminar</button>
                            <button v-if="!editando === rol.id && rol.usuarios > 0" :disabled="cargando"
                                    class="boton-tabla boton-peligro" @click="eliminar(rol)" title="Tiene usuarios: se desactivará">
                                Desactivar
                            </button>
                        </template>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>

    <div v-if="roles.length === 0 && !cargando" class="texto-tenue">No se encontraron roles.</div>

    <nav class="paginacion" aria-label="Paginación de roles" v-if="totalPaginas > 1">
        <button :disabled="pagina === 1" @click="cambiarPagina(pagina - 1)">← Anterior</button>
        <button v-for="n in paginasVisibles" :key="n"
                :class="{ activa: n === pagina }"
                @click="cambiarPagina(n)">{{ n }}</button>
        <button :disabled="pagina === totalPaginas" @click="cambiarPagina(pagina + 1)">Siguiente →</button>
    </nav>

    <p class="texto-tenue nota-panel">
        <strong>Nota:</strong> un rol con usuarios asignados no se elimina: se desactiva para conservar el historial.
        El rol <code>SUPER_ADMIN</code> no se puede editar, desactivar ni eliminar.
    </p>
</div>

<!-- Token antifalsificación para las peticiones AJAX (cookie auth). -->
<input id="token-antifalsificacion" type="hidden" value="@tokens.RequestToken" />

@section Scripts {
    <script src="~/lib/vue/vue.global.js" asp-append-version="true"></script>
    <script src="~/js/roles-vue.js" asp-append-version="true"></script>
}
