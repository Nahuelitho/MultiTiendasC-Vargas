<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tu Tienda Cerca</title>
    <link rel="stylesheet" href="~/css/colores.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/estilos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cabecera.css" asp-append-version="true" />
    @await RenderSectionAsync("Estilos", required: false)
</head>
<body>
    <header class="encabezado">
        <div class="contenedor-encabezado">
            <a class="marca" asp-area="" asp-controller="Inicio" asp-action="Inicio" aria-label="Ir al inicio de Tu Tienda Cerca">
                <span class="distintivo-marca" aria-hidden="true">tt</span>
                <span>Tu Tienda Cerca</span>
            </a>

            <div class="barra-busqueda" role="search">
                <label class="oculto" for="busqueda">Buscar productos o empresas</label>
                <input id="busqueda" type="search" placeholder="Buscar productos o empresas" autocomplete="off" />
            </div>

            <nav class="navegacion-principal" aria-label="Navegación principal">
                <a asp-area="" asp-controller="Inicio" asp-action="Inicio">Inicio</a>
                <a asp-area="" asp-controller="Cuenta" asp-action="Crear">Crear cuenta</a>
            </nav>
        </div>
    </header>

    <main class="contenido-principal" role="main">
        @RenderBody()
    </main>

    <footer class="pie">
        <div class="contenedor-pie">
            <span>&copy; 2026 Tu Tienda Cerca</span>
        </div>
    </footer>
</body>
</html>
