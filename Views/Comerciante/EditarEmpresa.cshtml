@using MultiTenantCSharpVargas.ViewModels
@model CrearEmpresaVista

@{
    ViewData["Title"] = "Editar mi empresa";
}

@section Estilos {
    <link rel="stylesheet" href="~/css/componentes/tarjeta-cuenta.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/componentes/perfil.css" asp-append-version="true" />
}

<div class="perfil">
    <div class="perfil-encabezado">
        <h1>Mi empresa</h1>
        <p>Actualizá los datos del comercio y el WhatsApp que recibe los pedidos.</p>
    </div>

    <div class="perfil-columnas">
        <section class="tarjeta-cuenta">
            <h2>Datos del comercio</h2>

            <div asp-validation-summary="All" class="alerta-error"></div>

            <form asp-action="EditarEmpresa" method="post">
                <div class="campo">
                    <label for="nombre">Nombre</label>
                    <input id="nombre" name="Nombre" value="@Model.Nombre" maxlength="120" required />
                </div>
                <div class="campo">
                    <label for="descripcion">Descripción</label>
                    <input id="descripcion" name="Descripcion" value="@Model.Descripcion" maxlength="500" />
                </div>
                <div class="campo">
                    <label for="direccion">Dirección</label>
                    <input id="direccion" name="Direccion" value="@Model.Direccion" maxlength="150" required />
                </div>
                <div class="campo">
                    <label for="localidad">Localidad</label>
                    <input id="localidad" name="Localidad" value="@Model.Localidad" maxlength="100" required />
                </div>
                <div class="campo">
                    <label for="telefono">Teléfono</label>
                    <input id="telefono" name="Telefono" value="@Model.Telefono" maxlength="100" />
                </div>
                <div class="campo">
                    <label for="whatsapp">WhatsApp para pedidos</label>
                    <input id="whatsapp" type="tel" name="WhatsApp" value="@Model.WhatsApp" maxlength="30" placeholder="Ej: 5491123456789" />
                    <small class="texto-tenue">Con código de país y sin espacios ni guiones.</small>
                </div>
                <div class="campo">
                    <label for="mediosPago">Medios de pago</label>
                    <input id="mediosPago" name="MediosDePago" value="@Model.MediosDePago" maxlength="250" />
                </div>
                <div class="campo">
                    <label>
                        <input type="checkbox" name="OfreceDelivery" value="true" checked="@Model.OfreceDelivery" />
                        Ofrece delivery
                    </label>
                    <input type="hidden" name="OfreceDelivery" value="false" />
                </div>
                <button type="submit">Guardar cambios</button>
            </form>

            <p><a asp-action="ProductosVue">Volver al panel</a></p>
        </section>
    </div>
</div>
