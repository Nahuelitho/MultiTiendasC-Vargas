@model ModeloError
@{
    ViewData["Title"] = "Ocurrio un error";
}

<section class="pagina-error">
    <h1>Ocurrio un error</h1>
    <p>No pudimos completar la solicitud.</p>

    @if (Model.MostrarIdentificador)
    {
        <p>Identificador: <code>@Model.IdentificadorSolicitud</code></p>
    }
</section>
