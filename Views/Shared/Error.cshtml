@model ModeloError
@using MultiTenantCSharpVargas.ViewModels
@{
    ViewData["Title"] = Model.Titulo;
}

<section class="pagina-error" aria-labelledby="titulo-error">
    <span class="codigo-error">@Model.CodigoEstado</span>
    <h1 id="titulo-error">@Model.Titulo</h1>
    <p>@Model.Mensaje</p>

    @if (Model.MostrarIdentificador)
    {
        <p class="detalle-error">Identificador de la solicitud: <code>@Model.IdentificadorSolicitud</code></p>
    }

    <div class="acciones-error">
        <a class="boton-principal" asp-controller="Inicio" asp-action="Inicio">Volver al inicio</a>
        <a class="boton-secundario-enlace" asp-controller="Inicio" asp-action="Inicio" asp-route-vista="productos">Ver productos</a>
    </div>
</section>
