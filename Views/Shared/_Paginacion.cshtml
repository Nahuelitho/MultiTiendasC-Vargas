@model PaginacionVista
@using MultiTenantCSharpVargas.ViewModels
@{
    var totalPages = Model.TotalPages;
    var current   = Model.Page;
    var size      = Model.PageSize;
    var total     = Model.TotalItems;
}

<nav aria-label="Paginación">
    <ul class="pagination">

        <!-- Botón «Primera» -->
        <li class="page-item @(current == 1 ? "disabled" : "")">
            <a class="page-link" asp-route-page="1" asp-route-pageSize="@size">« Primera</a>
        </li>

        <!-- Botón «Anterior» -->
        <li class="page-item @(current == 1 ? "disabled" : "")">
            <a class="page-link" asp-route-page="@(current - 1)" asp-route-pageSize="@size">« Anterior</a>
        </li>

        @* Rango de números *@
        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == current ? "active" : "")">
                <a class="page-link" asp-route-page="@i" asp-route-pageSize="@size">@i</a>
            </li>
        }

        <!-- Botón «Siguiente» -->
        <li class="page-item @(current == totalPages ? "disabled" : "")">
            <a class="page-link" asp-route-page="@(current + 1)" asp-route-pageSize="@size">Siguiente »</a>
        </li>

        <!-- Botón «Última» -->
        <li class="page-item @(current == totalPages ? "disabled" : "")">
            <a class="page-link" asp-route-page="@totalPages" asp-route-pageSize="@size">Última »</a>
        </li>

    </ul>
</nav>

@* Pequeña ayuda para que la URL mantenga los parámetros *@
@if (total > size)
{
    <small class="text-muted">
        Mostrando @size de @total registros
    </small>
}