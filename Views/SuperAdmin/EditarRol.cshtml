@model MultiTenantCSharpVargas.Models.Rol

@{
    ViewData["Title"] = "Editar rol";
    var esSuperAdmin = Model.Codigo == "SUPER_ADMIN";
}

@section Estilos {
    <link rel="stylesheet" href="~/css/componentes/panel-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/componentes/tarjeta-cuenta.css" asp-append-version="true" />
}

<div class="tarjeta-cuenta">
    <h2>Editar rol</h2>

    @if (!string.IsNullOrEmpty(ViewData["Error"] as string))
    {
        <div class="alerta-error">@ViewData["Error"]</div>
    }

    @if (esSuperAdmin)
    {
        <p class="aviso">El rol SUPER_ADMIN no puede cambiar de código ni desactivarse.</p>
    }

    <form asp-action="EditarRol" method="post">
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="campo">
            <label for="nombre">Nombre visible</label>
            <input id="nombre" name="nombre" value="@Model.Nombre" maxlength="40" required />
        </div>

        <div class="campo">
            <label for="codigo">Código interno</label>
            <input id="codigo" name="codigo" value="@Model.Codigo" maxlength="40" required readonly="@(esSuperAdmin ? "readonly" : null)" />
        </div>

        <div class="campo">
            <label for="activo">Estado</label>
            <select id="activo" name="activo" disabled="@(esSuperAdmin ? "disabled" : null)">
                <option value="true" selected="@(Model.Activo ? "selected" : null)">Activo</option>
                <option value="false" selected="@(!Model.Activo ? "selected" : null)">Inactivo</option>
            </select>
            @if (esSuperAdmin)
            {
                <input type="hidden" name="activo" value="true" />
            }
        </div>

        <button type="submit">Guardar cambios</button>
    </form>

    <p><a asp-action="Roles">Volver a roles</a></p>
</div>
