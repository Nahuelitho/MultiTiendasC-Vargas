@model PaginacionVista
@using MultiTenantCSharpVargas.ViewModels
@{
    var totalPages = Model.TotalPages;
    if (totalPages == 0) totalPages = 1;
    var current = Model.Page;
    var size = Model.PageSize;
    var total = Model.TotalItems;
    var busqueda = Model.Busqueda;
    var vista = Model.Vista;
}

@if (totalPages > 1)
{
    <nav class="paginacion-nav" aria-label="Paginación">
        <a class="pag-btn @(current == 1 ? "disabled" : "")"
           asp-route-page="1" asp-route-pageSize="@size" asp-route-busqueda="@busqueda" asp-route-vista="@vista">« Primera</a>

        <a class="pag-btn @(current == 1 ? "disabled" : "")"
           asp-route-page="@(current - 1)" asp-route-pageSize="@size" asp-route-busqueda="@busqueda" asp-route-vista="@vista">« Anterior</a>

        @for (int i = 1; i <= totalPages; i++)
        {
            if (i == current)
            {
                <span class="pag-btn active">@i</span>
            }
            else if (i <= 2 || i > totalPages - 2 || Math.Abs(i - current) <= 1)
            {
                <a class="pag-btn" asp-route-page="@i" asp-route-pageSize="@size" asp-route-busqueda="@busqueda" asp-route-vista="@vista">@i</a>
            }
            else if (Math.Abs(i - current) == 2)
            {
                <span class="pag-dots">...</span>
            }
        }

        <a class="pag-btn @(current == totalPages ? "disabled" : "")"
           asp-route-page="@(current + 1)" asp-route-pageSize="@size" asp-route-busqueda="@busqueda" asp-route-vista="@vista">Siguiente »</a>

        <a class="pag-btn @(current == totalPages ? "disabled" : "")"
           asp-route-page="@totalPages" asp-route-pageSize="@size" asp-route-busqueda="@busqueda" asp-route-vista="@vista">Última »</a>
    </nav>
    
    <div class="paginacion-info">
        Mostrando @size de @total comercios
    </div>
}
