@using MultiTenantCSharpVargas.ViewModels
@{
    ViewData["Title"] = "Gestión Productos Vue";
}
@section Estilos {
    <link rel="stylesheet" href="~/css/componentes/panel-comerciante.css" asp-append-version="true" />
}

<div id="app-vue-productos" class="panel-comerciante panel-comerciante-ancho">
    <div class="panel-cabecera">
        <div>
            <span class="etiqueta-seccion">Panel comerciante • Vue.js + API JWT</span>
            <h1>Productos SPA</h1>
            <p class="texto-tenue">ABM completo vía AJAX sin recargar - Requisito consigna</p>
        </div>
        <div class="acciones-panel">
            <input v-model="search" @@input="debouncedBuscar" placeholder="Buscar..." class="input-busqueda" />
            <button class="boton-principal" @@click="abrirModalCrear">+ Nuevo</button>
        </div>
    </div>

    <div class="tarjetas-resumen">
        <div class="tarjeta-resumen"><span class="numero">{{ total }}</span><span class="etiqueta">Total</span></div>
        <div class="tarjeta-resumen"><span class="numero">{{ page }}/{{ totalPages }}</span><span class="etiqueta">Página</span></div>
        <div class="tarjeta-resumen"><span class="numero">{{ productos.length }}</span><span class="etiqueta">En esta página</span></div>
    </div>

    <div v-if="loading" class="tarjeta-vacia"><p>Cargando...</p></div>
    <div v-else class="grilla-tarjetas">
        <div v-for="p in productos" :key="p.id" class="tarjeta-gestion">
            <article class="tarjeta-catalogo">
                <div class="tarjeta-imagen-contenedor">
                    <img v-if="p.imagen" :src="p.imagen" :alt="p.nombre" />
                    <span v-else class="tarjeta-imagen-vacia">{{ p.nombre[0] }}</span>
                </div>
                <div class="tarjeta-cuerpo">
                    <span class="tarjeta-etiqueta">{{ p.empresa }}</span>
                    <h3>{{ p.nombre }}</h3>
                    <div class="tarjeta-pie">
                        <span class="tarjeta-precio">$ {{ p.precio }}</span>
                        <span :class="p.tieneStock ? '' : 'sin-stock'">{{ p.tieneStock ? 'Stock: '+p.stock : 'Sin stock' }}</span>
                    </div>
                </div>
            </article>
            <div class="acciones-tarjeta">
                <button class="enlace-accion" @@click="abrirModalEditar(p)">Editar</button>
                <button class="boton-tabla boton-peligro" @@click="eliminar(p.id)">Eliminar</button>
            </div>
        </div>
    </div>

    <!-- Paginado servidor -->
    <nav class="paginacion-vue" v-if="totalPages > 1">
        <button :disabled="page==1" @@click="cambiarPagina(page-1)">« Anterior</button>
        <span>Página {{ page }} de {{ totalPages }}</span>
        <button :disabled="page==totalPages" @@click="cambiarPagina(page+1)">Siguiente »</button>
    </nav>

    <!-- Modal Crear/Editar -->
    <div v-if="showModal" class="modal-overlay" @@click.self="showModal=false">
        <div class="modal-contenido tarjeta-cuenta">
            <h2>{{ editando ? 'Editar' : 'Nuevo' }} Producto</h2>
            <div class="campo"><label>Nombre</label><input v-model="form.nombre" /></div>
            <div class="campo"><label>Descripción</label><textarea v-model="form.descripcion"></textarea></div>
            <div class="campos-dobles">
                <div class="campo"><label>Precio</label><input type="number" v-model.number="form.precio" step="0.01" /></div>
                <div class="campo"><label>Stock</label><input type="number" v-model.number="form.stock" /></div>
            </div>
            <div class="campo">
                <label>Empresa (búsqueda asíncrona)</label>
                <input v-model="empresaQuery" @@input="buscarEmpresas" placeholder="Escribe al menos 2 letras..." />
                <ul v-if="empresasSugeridas.length" class="sugerencias">
                    <li v-for="e in empresasSugeridas" @@click="seleccionarEmpresa(e)">{{ e.nombre }} - {{ e.localidad }}</li>
                </ul>
                <small v-if="form.empresaId">Seleccionada ID: {{ form.empresaId }}</small>
            </div>
            <div class="acciones-formulario">
                <button class="boton-principal" @@click="guardar">{{ editando ? 'Guardar' : 'Crear' }}</button>
                <button class="boton-secundario-enlace" @@click="showModal=false">Cancelar</button>
            </div>
        </div>
    </div>

    <!-- Busqueda asíncrona demo -->
    <div class="bloque-busqueda-async" style="margin-top:2rem">
        <h3>Búsqueda asíncrona de productos (requisito)</h3>
        <input v-model="qAsync" @@input="buscarAsyncProductos" placeholder="Busca producto por nombre..." />
        <ul><li v-for="r in resultadosAsync">{{ r.nombre }} - ${{ r.precio }}</li></ul>
    </div>
</div>

@section Scripts {
<script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
<script>
const { createApp, ref, onMounted } = Vue;
createApp({
    setup(){
        const productos = ref([]); const total = ref(0); const page = ref(1); const totalPages = ref(1); const pageSize = 10;
        const search = ref(''); const loading = ref(false);
        const showModal = ref(false); const editando = ref(null);
        const form = ref({ nombre:'', descripcion:'', precio:0, stock:0, empresaId: 1 });
        const empresaQuery = ref(''); const empresasSugeridas = ref([]);
        const qAsync = ref(''); const resultadosAsync = ref([]);
        const API = '/api/productos';

        const getToken = () => localStorage.getItem('jwt_token') || '';

        async function cargar(){
            loading.value = true;
            const res = await fetch(`${API}?page=${page.value}&pageSize=${pageSize}&search=${encodeURIComponent(search.value)}`);
            const json = await res.json(); productos.value = json.data; total.value = json.total; totalPages.value = json.totalPages; loading.value=false;
        }
        function cambiarPagina(n){ page.value=n; cargar(); }
        function debouncedBuscar(){ page.value=1; setTimeout(cargar,300); }

        function abrirModalCrear(){ editando.value=null; form.value={nombre:'',descripcion:'',precio:0,stock:0,empresaId:1}; showModal.value=true; }
        function abrirModalEditar(p){ editando.value=p; form.value={nombre:p.nombre,descripcion:'',precio:p.precio,stock:p.stock,empresaId:p.empresaId}; showModal.value=true; }

        async function guardar(){
            const token = getToken();
            const headers = { 'Content-Type':'application/json', 'Authorization': `Bearer ${token}` };
            const dto = { nombre: form.value.nombre, descripcion: form.value.descripcion, precio: form.value.precio, stock: form.value.stock, empresaId: form.value.empresaId };
            let res;
            if(editando.value){ res = await fetch(`${API}/${editando.value.id}`, { method:'PUT', headers, body: JSON.stringify(dto) }); }
            else{ res = await fetch(API, { method:'POST', headers, body: JSON.stringify(dto) }); }
            if(res.ok){ showModal.value=false; cargar(); } else { alert('Error - revisa token JWT'); }
        }
        async function eliminar(id){
            if(!confirm('¿Eliminar?')) return;
            const res = await fetch(`${API}/${id}`, { method:'DELETE', headers: { 'Authorization': `Bearer ${getToken()}` } });
            if(res.ok || res.status===204) cargar();
        }

        // Búsqueda asíncrona de empresas (simulada - adapta a tu endpoint real)
        async function buscarEmpresas(){
            if(empresaQuery.value.length < 2) return;
            // Aquí llamarías a /api/empresas/buscar?q=
            // Por ahora mock
            empresasSugeridas.value = [{ id:1, nombre: 'Empresa Demo', localidad: 'San Luis' }];
        }
        function seleccionarEmpresa(e){ form.value.empresaId = e.id; empresaQuery.value = e.nombre; empresasSugeridas.value=[]; }

        async function buscarAsyncProductos(){
            if(qAsync.value.length < 2) { resultadosAsync.value=[]; return; }
            const res = await fetch(`${API}/buscar?q=${encodeURIComponent(qAsync.value)}`);
            resultadosAsync.value = await res.json();
        }

        onMounted(cargar);
        return { productos, total, page, totalPages, search, loading, showModal, editando, form, empresaQuery, empresasSugeridas, qAsync, resultadosAsync, cargar, cambiarPagina, debouncedBuscar, abrirModalCrear, abrirModalEditar, guardar, eliminar, buscarEmpresas, seleccionarEmpresa, buscarAsyncProductos };
    }
}).mount('#app-vue-productos');
</script>
<style>.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;z-index:999}.modal-contenido{min-width:400px}.sugerencias{background:#fff;border:1px solid #ddd;list-style:none;padding:0}.sugerencias li{padding:.5rem;cursor:pointer}.sugerencias li:hover{background:#f0f0f0}.paginacion-vue{display:flex;gap:1rem;justify-content:center;margin-top:1rem}</style>
}
</script>
