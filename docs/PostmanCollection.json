{
  "info": {
    "name": "Tu Tienda Cerca - API JWT",
    "description": "Colección para probar la Web API REST protegida con JWT. Primero ejecutar 'Login JWT': el token se guarda automáticamente en la variable jwt_token y lo usan los demás requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login correcto', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "if (data.token) {",
              "    pm.collectionVariables.set('jwt_token', data.token);",
              "    console.log('Token guardado en jwt_token');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"Comerciante2@test.com\",\n  \"password\": \"Comerciante123.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Usuario autenticado (me)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me"]
        }
      }
    },
    {
      "name": "Listar productos paginado",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/productos?page=1&pageSize=5&search=pan",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "pageSize", "value": "5" },
            { "key": "search", "value": "pan" }
          ]
        }
      }
    },
    {
      "name": "Búsqueda asíncrona de productos",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/productos/buscar?q=pa",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "buscar"],
          "query": [{ "key": "q", "value": "pa" }]
        }
      }
    },
    {
      "name": "Obtener producto por id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/productos/13",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "13"]
        }
      }
    },
    {
      "name": "Crear producto (JSON)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Producto de prueba API\",\n  \"descripcion\": \"Creado desde Postman\",\n  \"precio\": 1234.50,\n  \"stock\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos"]
        }
      }
    },
    {
      "name": "Crear producto con imagen (FormData)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "nombre", "value": "Producto con imagen", "type": "text" },
            { "key": "descripcion", "value": "Subido desde Postman", "type": "text" },
            { "key": "precio", "value": "2500", "type": "text" },
            { "key": "stock", "value": "5", "type": "text" },
            { "key": "Imagen", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos/con-imagen",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "con-imagen"]
        }
      }
    },
    {
      "name": "Editar producto (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Producto de prueba API editado\",\n  \"descripcion\": \"Actualizado desde Postman\",\n  \"precio\": 1500,\n  \"stock\": 7\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{productoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "{{productoId}}"]
        }
      }
    },
    {
      "name": "Eliminar producto (DELETE)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{productoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "{{productoId}}"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5122" },
    { "key": "jwt_token", "value": "" },
    { "key": "productoId", "value": "1" }
  ]
}
